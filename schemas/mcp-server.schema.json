{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "description",
    "transport",
    "risk",
    "writeCapability",
    "defaultApprovalMode",
    "installable",
    "source",
    "versionPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "transport": {
      "enum": [
        "stdio",
        "http"
      ]
    },
    "command": {
      "type": "string"
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "url": {
      "type": "string"
    },
    "requiredEnv": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "writeCapability": {
      "type": "boolean"
    },
    "defaultApprovalMode": {
      "enum": [
        "auto",
        "prompt",
        "writes",
        "approve"
      ]
    },
    "installable": {
      "type": "boolean"
    },
    "projectRequired": {
      "type": "boolean"
    },
    "source": {
      "type": "object"
    },
    "versionPolicy": {
      "type": "string"
    },
    "bearerTokenEnvVar": {
      "type": "string"
    },
    "envHttpHeaders": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "enabledTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disabledTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transport": {
            "const": "stdio"
          }
        }
      },
      "then": {
        "required": [
          "command"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "const": "http"
          }
        }
      },
      "then": {
        "required": [
          "url"
        ]
      }
    }
  ],
  "additionalProperties": false
}
