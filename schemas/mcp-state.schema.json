{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "packVersion",
    "scope",
    "servers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packVersion": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "project",
        "user"
      ]
    },
    "servers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "definitionHash",
          "targets",
          "enabled"
        ],
        "properties": {
          "definitionHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "targets": {
            "type": "array",
            "items": {
              "enum": [
                "codex",
                "claude"
              ]
            },
            "uniqueItems": true
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
